<section class="media-gallery" style="padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;">
  <div class="container">
    {% if section.settings.title != blank %}
      <div class="section-header" data-aos="fade-up" style="text-align: center; margin-bottom: 60px;">
        <h2 class="h2">{{ section.settings.title }}</h2>
      </div>
    {% endif %}

    <div class="gallery-grid-custom" style="display: grid; grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr); gap: 20px;">
      {% for block in section.blocks %}
        <div class="gallery-item-custom" data-aos="fade-up" data-aos-delay="{{ forloop.index | times: 100 }}" style="overflow: hidden; border-radius: 12px; box-shadow: 0 10px 30px rgba(0,0,0,0.05);">
          {% if block.settings.image != blank %}
            <img src="{{ block.settings.image | image_url: width: 1200 }}" alt="{{ block.settings.image.alt | default: 'Gallery Image' }}" loading="lazy" style="width: 100%; height: auto; display: block; transition: transform 0.5s ease;">
          {% else %}
            <div style="background: #f4f4f4; padding-bottom: 100%; position: relative;">
              {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
            </div>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</section>

<style>
  .gallery-item-custom:hover img {
    transform: scale(1.05);
  }
  @media (max-width: 768px) {
    .gallery-grid-custom {
      grid-template-columns: 1fr !important;
      gap: 15px !important;
    }
  }
</style>

{% schema %}
{
  "name": "Media Gallery",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Our Visual Journey"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 3,
      "label": "Columns on Desktop"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 10,
      "default": 80,
      "label": "Padding Top (px)"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 10,
      "default": 80,
      "label": "Padding Bottom (px)"
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Select Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Media Gallery",
      "blocks": [
        { "type": "image" },
        { "type": "image" },
        { "type": "image" }
      ]
    }
  ]
}
{% endschema %}
