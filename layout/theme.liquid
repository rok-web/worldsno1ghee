<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#C8961E">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
      {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    {% render 'meta-tags' %}

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;0,700;1,400&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">

    {{ content_for_header }}

    {{ 'theme.css' | asset_url | stylesheet_tag }}
  </head>

  <body class="template-{{ template.name | handle }}">
    <a class="skip-to-content-link button visually-hidden" href="#MainContent">
      Skip to content
    </a>

    {% section 'announcement-bar' %}
    {% section 'header' %}

    <main id="MainContent" class="content-for-layout focus-none" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% section 'footer' %}

    <!-- Cart Drawer -->
    <div class="drawer-overlay"></div>
    <div class="cart-drawer">
      <div class="drawer-header">
        <h3 class="h4">Your Cart</h3>
        <button class="cart-drawer-close">&times;</button>
      </div>
      <div class="drawer-content">
        <!-- Content injected via JS -->
      </div>
      <div class="drawer-footer">
        <div class="subtotal-row" style="display: flex; justify-content: space-between; margin-bottom: 20px;">
          <strong>Subtotal</strong>
          <span class="drawer-subtotal-value">{{ cart.total_price | money }}</span>
        </div>
        <a href="/checkout" class="btn btn-gold" style="width: 100%; text-align: center;">Proceed to Checkout</a>
      </div>
    </div>

    <!-- WhatsApp Floating Button -->
    <a href="https://wa.me/918555926620" class="whatsapp-float" target="_blank" aria-label="Chat with us on WhatsApp">
      {% render 'icons', icon: 'whatsapp' %}
    </a>

    <!-- Scripts -->
    <script>
      window.shopUrl = '{{ request.origin }}';
      window.routes = {
        cart_add_url: '{{ routes.cart_add_url }}',
        cart_change_url: '{{ routes.cart_change_url }}',
        cart_update_url: '{{ routes.cart_update_url }}',
        cart_url: '{{ routes.cart_url }}',
        predictive_search_url: '{{ routes.predictive_search_url }}'
      };
    </script>
    {{ 'theme.js' | asset_url | script_tag }}

    <!-- ===== LIVE TRACKER POPUP ===== -->
    <div id="live-tracker-popup">
      <!-- Main viewer count pill -->
      <div id="live-tracker-main" title="People viewing this site right now">
        <span class="tracker-dot"></span>
        <span id="live-viewer-count">—</span>
        <span class="tracker-label">live viewers</span>
      </div>
      <!-- Social-proof notification cards appear here -->
      <div id="live-notifications"></div>
    </div>

    <script>
    (function() {
      /* ── CONFIG ─────────────────────────────────── */
      var BASE_VIEWERS  = 24;   // starting point
      var VARIANCE      = 8;    // ± random swing
      var TICK_MS       = 5000; // how often count updates
      var NOTIF_INTERVAL= 12000;// how often a card appears
      var NOTIF_DURATION= 6000; // how long each card stays

      /* ── SOCIAL PROOF DATA ──────────────────────── */
      var events = [
        { icon: '🛒', title: 'Someone in Delhi just added to cart', sub: 'Bilona A2 Ghee – 500ml' },
        { icon: '✅', title: 'Order placed from Mumbai', sub: '2 × Pure A2 Ghee – 250ml' },
        { icon: '👀', title: '3 people are viewing this product', sub: 'Forest-Grazed A2 Cow Ghee' },
        { icon: '⭐', title: 'New 5-star review received', sub: '"Best ghee I\'ve ever tasted!"' },
        { icon: '🛒', title: 'Someone in Bangalore added to cart', sub: 'A2 Ghee – 1 kg Value Pack' },
        { icon: '✅', title: 'Order shipped to Hyderabad', sub: 'Bilona Ghee Subscription' },
        { icon: '🔥', title: 'Low stock alert!', sub: 'Only 7 units of 500ml left' },
        { icon: '👀', title: 'Customer from Pune is browsing', sub: 'Vedic Bilona Process Ghee' },
        { icon: '✅', title: 'Order confirmed from Chennai', sub: '3 × A2 Ghee Gift Set' },
        { icon: '⭐', title: 'Verified buyer rated 5 stars', sub: '"Authentic bilona taste – love it!"' },
      ];

      /* ── VIEWER COUNT ───────────────────────────── */
      var countEl = document.getElementById('live-viewer-count');
      var current = BASE_VIEWERS + Math.floor(Math.random() * VARIANCE);

      function updateCount() {
        var delta = Math.floor(Math.random() * 5) - 2;  // -2 to +2
        current = Math.max(8, Math.min(BASE_VIEWERS + VARIANCE, current + delta));
        countEl.textContent = current;
      }
      updateCount();
      setInterval(updateCount, TICK_MS);

      /* ── NOTIFICATION CARDS ─────────────────────── */
      var notifEl = document.getElementById('live-notifications');
      var shown   = 0;

      function showNotif() {
        var ev   = events[shown % events.length];
        shown++;

        var card = document.createElement('div');
        card.className = 'live-tracker-card';
        card.innerHTML =
          '<span class="tracker-dot"></span>' +
          '<span class="tracker-icon">' + ev.icon + '</span>' +
          '<div class="tracker-text">' +
            '<span class="tracker-title">' + ev.title + '</span>' +
            '<span class="tracker-subtitle">' + ev.sub + '</span>' +
          '</div>' +
          '<button class="tracker-dismiss" aria-label="Dismiss">&times;</button>';

        /* dismiss button */
        card.querySelector('.tracker-dismiss').addEventListener('click', function() {
          removeCard(card);
        });

        notifEl.appendChild(card);

        /* auto-remove after duration */
        var timer = setTimeout(function() { removeCard(card); }, NOTIF_DURATION);
        card._timer = timer;
      }

      function removeCard(card) {
        clearTimeout(card._timer);
        card.style.transition = 'opacity 0.4s, transform 0.4s';
        card.style.opacity    = '0';
        card.style.transform  = 'translateX(-40px)';
        setTimeout(function() {
          if (card.parentNode) card.parentNode.removeChild(card);
        }, 420);
      }

      /* stagger the first card */
      setTimeout(function() {
        showNotif();
        setInterval(showNotif, NOTIF_INTERVAL);
      }, 3000);

    })();
    </script>
    <!-- ===== END LIVE TRACKER ===== -->
  </body>
</html>
