<section class="contact-section">
  <div class="container">
    <div class="contact-container">
      <!-- Contact Info -->
      <div class="contact-info" data-aos="fade-right">
        <h2 class="h2" style="margin-bottom: 40px;">Get in Touch</h2>
        
        <div class="contact-info-block">
          <h4 class="footer-heading">Address</h4>
          <p>#15-116-12-2-10, Kamma Gadda Street, Madanapalle, Annamayya, Andhra Pradesh-517325</p>
        </div>

        <div class="contact-info-block">
          <h4 class="footer-heading">Email</h4>
          <p>Customer@worldsno1bestghee.in</p>
        </div>

        <div class="contact-info-block">
          <h4 class="footer-heading">WhatsApp</h4>
          <p>+91 8555-926620</p>
        </div>

        <div class="contact-info-block">
          <h4 class="footer-heading">FSSAI No</h4>
          <p>10124025000164</p>
        </div>
      </div>

      <!-- Contact Form -->
      <div class="contact-form-wrapper" data-aos="fade-left">
        {%- form 'contact', id: 'ContactForm' -%}
          {%- if form.posted_successfully? -%}
            <div class="form-success" style="padding: 20px; background: #e6ffed; border: 1px solid #b7eb8f; margin-bottom: 20px;">
              Thanks for contacting us. We'll get back to you as soon as possible.
            </div>
          {%- elsif form.errors -%}
            <div class="form-errors" style="padding: 20px; background: #fff1f0; border: 1px solid #ffa39e; margin-bottom: 20px;">
              {{ form.errors | default_errors }}
            </div>
          {%- endif -%}

          <div class="field">
            <input type="text" name="contact[name]" id="ContactForm-name" placeholder="Name" required>
          </div>
          <div class="field">
            <input type="email" name="contact[email]" id="ContactForm-email" placeholder="Email" required>
          </div>
          <div class="field">
            <input type="tel" name="contact[phone]" id="ContactForm-phone" placeholder="Phone Number">
          </div>
          <div class="field">
            <textarea rows="6" name="contact[body]" id="ContactForm-body" placeholder="Message" required></textarea>
          </div>
          
          <button type="submit" class="btn btn-gold" style="width: 100%;">Send Message</button>
        {%- endform -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Contact Form",
  "settings": []
}
{% endschema %}
