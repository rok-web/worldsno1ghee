<section class="lab-reports-section" style="padding: 60px 0; background-color: var(--color-white); text-align: center;">
  <div class="container">
    <div style="margin-bottom: 40px;" data-aos="fade-up">
      <a href="{{ section.settings.pdf_url }}" target="_blank" class="btn btn-outline" style="background-color: #007bff; color: white; border: none; padding: 12px 30px; text-transform: none; font-weight: 500; border-radius: 4px;">
        View Fullscreen
      </a>
    </div>

    <div class="pdf-container" data-aos="fade-up" style="height: 1000px; border: none; box-shadow: 0 10px 30px rgba(0,0,0,0.1);">
      <iframe src="https://docs.google.com/gview?embedded=true&url={{ section.settings.pdf_url | url_encode }}" style="width:100%; height:100%;" frameborder="0"></iframe>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Lab Reports",
  "settings": [
    {
      "type": "text",
      "id": "pdf_url",
      "label": "PDF URL",
      "default": "https://worldsno1bestghee.com/wp-content/uploads/2026/02/9da61a6b-9795-41e1-9073-aa0347d4f63d.pdf"
    }
  ]
}
{% endschema %}
