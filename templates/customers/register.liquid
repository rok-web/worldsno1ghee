<section class="customer-register" style="padding: 100px 0; background-color: var(--color-cream-bg); min-height: 80vh; display: flex; align-items: center;">
  <div class="container">
    <div class="login-card" style="max-width: 450px; margin: 0 auto; background: var(--color-white); padding: 40px; border-radius: 8px; box-shadow: 0 10px 30px rgba(0,0,0,0.05); text-align: center;" data-aos="fade-up">
      <h1 class="h3" style="margin-bottom: 10px;">Create Account</h1>
      <p style="margin-bottom: 30px; opacity: 0.6;">Join the Worldsno1bestghee family</p>

      {% form 'create_customer' %}
        {% if form.errors %}
          <div class="form-errors" style="color: #ff4d4f; margin-bottom: 20px; font-size: 14px;">
            {{ form.errors | default_errors }}
          </div>
        {% endif %}

        <div class="field" style="margin-bottom: 20px;">
          <input type="text" name="customer[first_name]" placeholder="First Name" required style="width: 100%; padding: 15px; border: 1px solid #ddd; border-radius: 4px;">
        </div>

        <div class="field" style="margin-bottom: 20px;">
          <input type="text" name="customer[last_name]" placeholder="Last Name" required style="width: 100%; padding: 15px; border: 1px solid #ddd; border-radius: 4px;">
        </div>

        <div class="field" style="margin-bottom: 20px;">
          <input type="email" name="customer[email]" placeholder="Email" required style="width: 100%; padding: 15px; border: 1px solid #ddd; border-radius: 4px;">
        </div>

        <div class="field" style="margin-bottom: 20px;">
          <input type="password" name="customer[password]" placeholder="Password" required style="width: 100%; padding: 15px; border: 1px solid #ddd; border-radius: 4px;">
        </div>

        <button type="submit" class="btn btn-gold" style="width: 100%; padding: 15px; margin-top: 20px;">Create Account</button>

        <div style="margin-top: 30px; font-size: 14px;">
          Already have an account? <a href="/account/login" style="color: var(--color-gold); font-weight: 600;">Log in</a>
        </div>
      {% endform %}
    </div>
  </div>
</section>
