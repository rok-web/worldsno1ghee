<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#C8961E">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
      {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    {% render 'meta-tags' %}

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;0,700;1,400&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">

    {{ content_for_header }}

    {{ 'theme.css' | asset_url | stylesheet_tag }}
  </head>

  <body class="template-{{ template.name | handle }}">
    <a class="skip-to-content-link button visually-hidden" href="#MainContent">
      Skip to content
    </a>

    {% section 'announcement-bar' %}
    {% section 'header' %}

    <main id="MainContent" class="content-for-layout focus-none" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% section 'footer' %}

    <!-- Cart Drawer -->
    <div class="drawer-overlay"></div>
    <div class="cart-drawer">
      <div class="drawer-header">
        <h3 class="h4">Your Cart</h3>
        <button class="cart-drawer-close">&times;</button>
      </div>
      <div class="drawer-content">
        <!-- Content injected via JS -->
      </div>
      <div class="drawer-footer">
        <div class="subtotal-row" style="display: flex; justify-content: space-between; margin-bottom: 20px;">
          <strong>Subtotal</strong>
          <span class="drawer-subtotal-value">{{ cart.total_price | money }}</span>
        </div>
        <a href="/checkout" class="btn btn-gold" style="width: 100%; text-align: center;">Proceed to Checkout</a>
      </div>
    </div>

    <!-- WhatsApp Floating Button -->
    <a href="https://wa.me/918555926620" class="whatsapp-float" target="_blank" aria-label="Chat with us on WhatsApp">
      {% render 'icons', icon: 'whatsapp' %}
    </a>

    <!-- ===== MOBILE STICKY BUY NOW BAR ===== -->
    <div id="mobile-buy-bar" aria-label="Buy Now">
      <a href="/collections/all" class="mobile-buy-btn" id="mobile-buy-now-cta">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/>
          <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
        </svg>
        Order Now — Free Delivery
      </a>
      <a href="https://wa.me/918555926620" class="mobile-wa-btn" target="_blank" aria-label="WhatsApp Order">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/>
        </svg>
      </a>
    </div>

    <style>
      /* ── Mobile Sticky Buy Bar ─────────────────── */
      #mobile-buy-bar {
        display: none; /* hidden by default, shown on mobile only */
      }

      @media (max-width: 768px) {
        #mobile-buy-bar {
          display: flex;
          align-items: center;
          gap: 10px;
          position: fixed;
          bottom: 0;
          left: 0;
          width: 100%;
          z-index: 1050;
          padding: 10px 14px calc(10px + env(safe-area-inset-bottom));
          background: rgba(26, 18, 8, 0.97);
          border-top: 1px solid rgba(200, 150, 30, 0.25);
          backdrop-filter: blur(8px);
          -webkit-backdrop-filter: blur(8px);
          box-shadow: 0 -4px 20px rgba(0,0,0,0.3);
        }

        .mobile-buy-btn {
          flex: 1;
          display: flex;
          align-items: center;
          justify-content: center;
          gap: 8px;
          background: var(--color-gold);
          color: #fff;
          font-family: var(--font-body);
          font-size: 14px;
          font-weight: 700;
          letter-spacing: 0.5px;
          text-transform: uppercase;
          border-radius: 8px;
          padding: 13px 20px;
          text-decoration: none;
          transition: background 0.2s, transform 0.15s;
          white-space: nowrap;
        }

        .mobile-buy-btn:active {
          background: var(--color-gold-light);
          transform: scale(0.98);
        }

        .mobile-wa-btn {
          flex-shrink: 0;
          display: flex;
          align-items: center;
          justify-content: center;
          background: #25d366;
          color: #fff;
          width: 48px;
          height: 48px;
          border-radius: 8px;
          text-decoration: none;
          transition: background 0.2s;
        }

        .mobile-wa-btn:active {
          background: #1ebe5d;
        }

        /* Push footer above the bar */
        .site-footer {
          padding-bottom: calc(80px + env(safe-area-inset-bottom));
        }
      }
    </style>
    <!-- ===== END MOBILE BUY BAR ===== -->

    <!-- Scripts -->
    <script>
      window.shopUrl = '{{ request.origin }}';
      window.routes = {
        cart_add_url: '{{ routes.cart_add_url }}',
        cart_change_url: '{{ routes.cart_change_url }}',
        cart_update_url: '{{ routes.cart_update_url }}',
        cart_url: '{{ routes.cart_url }}',
        predictive_search_url: '{{ routes.predictive_search_url }}'
      };
    </script>
    {{ 'theme.js' | asset_url | script_tag }}

    <!-- ===== LIVE TRACKER POPUP ===== -->
    <div id="live-tracker-popup">
      <div id="live-tracker-main" title="People currently browsing">
        <span class="tracker-dot"></span>
        <span id="live-viewer-count">—</span>
        <span class="tracker-label">people browsing now</span>
      </div>
      <div id="live-notifications"></div>
    </div>

    <script>
    (function () {

      /* ─── CONFIG ──────────────────────────────── */
      var BASE   = 22;
      var SWING  = 10;
      var TICK   = 6000;          // viewer count refresh (ms)
      var MIN_INTERVAL = 110000;  // ~2 min min delay between cards
      var MAX_INTERVAL = 130000;  // ~2 min max delay between cards
      var CARD_LIFE    = 12000;   // card stays 12s — plenty of reading time

      /* ─── DATA ────────────────────────────────── */
      var names   = ['Priya S.','Amit K.','Rekha M.','Suresh P.','Ananya R.',
                     'Vikram T.','Deepa N.','Rohit J.','Kavita L.','Sanjay B.'];
      var cities  = ['Delhi','Mumbai','Bangalore','Hyderabad','Pune',
                     'Chennai','Kolkata','Ahmedabad','Jaipur','Lucknow'];
      var products = [
        'Bilona A2 Ghee – 500 ml',
        'Forest-Grazed A2 Ghee – 250 ml',
        'A2 Cow Ghee – 1 kg Pack',
        'Vedic Bilona Ghee – 500 ml',
        'A2 Ghee Gift Set',
        'Premium Bilona Ghee – 250 ml',
      ];
      var reviews = [
        '"Pure, aromatic and absolutely authentic."',
        '"Finally found real bilona ghee. Worth every rupee."',
        '"Best quality A2 ghee I have ever used."',
        '"My family has been using this for 3 months now."',
        '"The fragrance itself tells you it is genuine."',
      ];

      /* Event types: purchase | cart | stock | review | viewing */
      function randomFrom(arr) { return arr[Math.floor(Math.random() * arr.length)]; }

      function buildEvent() {
        var r = Math.random();
        if      (r < 0.28) return { type: 'purchase', name: randomFrom(names), city: randomFrom(cities), product: randomFrom(products) };
        else if (r < 0.52) return { type: 'cart',     name: randomFrom(names), city: randomFrom(cities), product: randomFrom(products) };
        else if (r < 0.67) return { type: 'review',   name: randomFrom(names), city: randomFrom(cities), review: randomFrom(reviews) };
        else if (r < 0.80) return { type: 'stock',    product: randomFrom(products), qty: Math.floor(Math.random() * 6) + 3 };
        else               return { type: 'viewing',  count: Math.floor(Math.random() * 8) + 2, product: randomFrom(products) };
      }

      /* ─── SVG ICONS (no emoji) ────────────────── */
      var SVG = {
        purchase: '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>',
        cart:     '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>',
        review:   '<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" stroke="none"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>',
        stock:    '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>',
        viewing:  '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>',
      };

      /* Accent colour per type */
      var ACCENT = {
        purchase: '#C8961E',
        cart:     '#4a9eff',
        review:   '#f59e0b',
        stock:    '#ef4444',
        viewing:  '#8b9eff',
      };

      /* Label per type */
      function buildTitle(ev) {
        if (ev.type === 'purchase') return ev.name + ' from ' + ev.city + ' just purchased';
        if (ev.type === 'cart')     return ev.name + ' from ' + ev.city + ' added to cart';
        if (ev.type === 'review')   return ev.name + ' from ' + ev.city + ' left a review';
        if (ev.type === 'stock')    return 'Only ' + ev.qty + ' units left in stock';
        if (ev.type === 'viewing')  return ev.count + ' people are viewing this right now';
      }
      function buildSub(ev) {
        if (ev.type === 'purchase') return ev.product;
        if (ev.type === 'cart')     return ev.product;
        if (ev.type === 'review')   return ev.review;
        if (ev.type === 'stock')    return ev.product;
        if (ev.type === 'viewing')  return ev.product;
      }

      /* Initials avatar */
      function initials(name) {
        if (!name) return '••';
        return name.split(' ').map(function(p){ return p[0]; }).join('').slice(0,2).toUpperCase();
      }

      /* "X min ago" label */
      function timeAgo() {
        var m = Math.floor(Math.random() * 8) + 1;
        return m === 1 ? 'just now' : m + ' min ago';
      }

      /* ─── VIEWER COUNT ────────────────────────── */
      var countEl = document.getElementById('live-viewer-count');
      var current = BASE + Math.floor(Math.random() * SWING);

      function updateCount() {
        var delta = Math.floor(Math.random() * 5) - 2;
        current = Math.max(6, Math.min(BASE + SWING, current + delta));
        countEl.textContent = current;
      }
      updateCount();
      setInterval(updateCount, TICK);

      /* ─── NOTIFICATION CARDS ──────────────────── */
      var notifEl = document.getElementById('live-notifications');

      function showCard() {
        var ev      = buildEvent();
        var accent  = ACCENT[ev.type];
        var title   = buildTitle(ev);
        var sub     = buildSub(ev);
        var ago     = (ev.type === 'stock' || ev.type === 'viewing') ? '' : timeAgo();
        var showAvatar = (ev.type === 'purchase' || ev.type === 'cart' || ev.type === 'review');
        var avatarHTML = showAvatar
          ? '<div class="nt-avatar" style="background:' + accent + '22;color:' + accent + ';border:1px solid ' + accent + '44;">' + initials(ev.name) + '</div>'
          : '<div class="nt-icon-wrap" style="background:' + accent + '18;color:' + accent + ';">' + SVG[ev.type] + '</div>';

        var card = document.createElement('div');
        card.className = 'nt-card';
        card.innerHTML =
          '<div class="nt-accent-bar" style="background:' + accent + ';"></div>' +
          avatarHTML +
          '<div class="nt-body">' +
            '<p class="nt-title">' + title + '</p>' +
            '<p class="nt-sub">' + sub + '</p>' +
            (ago ? '<p class="nt-time">' + ago + '</p>' : '') +
          '</div>' +
          '<button class="nt-close" aria-label="Close">&#x2715;</button>' +
          '<div class="nt-progress"><div class="nt-progress-bar" style="animation-duration:' + CARD_LIFE + 'ms;"></div></div>';

        card.querySelector('.nt-close').addEventListener('click', function () { removeCard(card); });
        notifEl.appendChild(card);

        var t = setTimeout(function () { removeCard(card); }, CARD_LIFE);
        card._t = t;

        /* keep max 2 cards visible */
        var cards = notifEl.querySelectorAll('.nt-card');
        if (cards.length > 2) removeCard(cards[0]);
      }

      function removeCard(card) {
        clearTimeout(card._t);
        card.style.transition = 'opacity 0.35s ease, transform 0.35s ease';
        card.style.opacity    = '0';
        card.style.transform  = 'translateX(-16px)';
        setTimeout(function () { if (card.parentNode) card.parentNode.removeChild(card); }, 380);
      }

      function scheduleNext() {
        var delay = MIN_INTERVAL + Math.random() * (MAX_INTERVAL - MIN_INTERVAL);
        setTimeout(function () { showCard(); scheduleNext(); }, delay);
      }

      /* First card after 4 s, then random intervals */
      setTimeout(function () { showCard(); scheduleNext(); }, 4000);

    })();
    </script>
    <!-- ===== END LIVE TRACKER ===== -->
  </body>
</html>
