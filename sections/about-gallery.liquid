<section class="about-gallery" style="padding: 100px 0; background-color: var(--color-cream-bg);">
  <div class="container">
    <div class="section-header" data-aos="fade-up">
      <h2 class="h2">Life at the Sanctuary</h2>
    </div>

    <div class="gallery-masonry">
      {% for block in section.blocks %}
        <div class="gallery-item" data-aos="fade-up">
          {% if block.settings.image != blank %}
            <img src="{{ block.settings.image | image_url: width: 800 }}" alt="{{ block.settings.image.alt | default: 'Farm Life' }}" loading="lazy">
          {% else %}
            {{ 'image' | placeholder_svg_tag }}
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "About Gallery",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Life at the Sanctuary"
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Select Image"
        }
      ]
    }
  ]
}
{% endschema %}
