<section class="section-padding">
  <div class="container">
    <div class="section-title">
      <h2>Have questions? Get in touch!</h2>
    </div>

    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 60px; margin-top: 50px;">
      <div>
        <h3 style="margin-bottom: 20px;">Contact Details</h3>
        <p style="margin-bottom: 20px;"><strong>Address:</strong><br>#15-116-12-2-10, Kamma Gadda Street, Madanapalle, Annamayya, Andhra Pradesh-517325</p>
        <p style="margin-bottom: 20px;"><strong>Email:</strong><br>Customer@worldsno1bestghee.in</p>
        <p style="margin-bottom: 20px;"><strong>Phone:</strong><br>+91 8555-926620</p>
      </div>

      <div>
        {% form 'contact' %}
          {% if form.posted_successfully? %}
            <p style="color: green; margin-bottom: 20px;">Thanks for contacting us. We'll get back to you as soon as possible.</p>
          {% endif %}

          <div style="margin-bottom: 15px;">
            <input type="text" name="contact[name]" placeholder="Name" style="width: 100%; padding: 12px; border: 1px solid #ddd;" required>
          </div>
          <div style="margin-bottom: 15px;">
            <input type="email" name="contact[email]" placeholder="Email" style="width: 100%; padding: 12px; border: 1px solid #ddd;" required>
          </div>
          <div style="margin-bottom: 15px;">
            <input type="tel" name="contact[phone]" placeholder="Phone Number" style="width: 100%; padding: 12px; border: 1px solid #ddd;">
          </div>
          <div style="margin-bottom: 15px;">
            <textarea name="contact[body]" placeholder="Message" rows="5" style="width: 100%; padding: 12px; border: 1px solid #ddd;" required></textarea>
          </div>
          <button type="submit" class="btn">Send Message</button>
        {% endform %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Contact Form",
  "settings": []
}
{% endschema %}
