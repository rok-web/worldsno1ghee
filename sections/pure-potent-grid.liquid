<section class="pure-potent-precious" style="padding: 100px 0; background-color: var(--color-white);">
  <div class="container">
    <div class="section-header" data-aos="fade-up" style="text-align: center; margin-bottom: 60px;">
      <h2 class="h1" style="font-size: 64px; font-weight: 500;">{{ section.settings.title }}</h2>
    </div>

    <div class="product-grid">
      {% for block in section.blocks %}
        <div class="custom-product-card" data-aos="fade-up" data-aos-delay="{{ forloop.index | times: 100 }}">
          <div class="card-image-wrapper">
            {% if block.settings.sale_label != blank %}
              <span class="sale-badge">{{ block.settings.sale_label }}</span>
            {% endif %}
            
            {% if block.settings.image != blank %}
              <img src="{{ block.settings.image | image_url: width: 800, height: 800, crop: 'center' }}" alt="{{ block.settings.title }}">
            {% elsif block.settings.asset_image != blank %}
              <img src="{{ block.settings.asset_image | asset_url }}" alt="{{ block.settings.title }}">
            {% else %}
              {{ 'product-1' | placeholder_svg_tag }}
            {% endif %}

            <div class="quick-view-bar">
              <span class="icon-eye">{% render 'icons', icon: 'search' %}</span> Quick view
            </div>
          </div>
          <div class="card-info">
            <h3>{{ block.settings.title }}</h3>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

<style>
  .pure-potent-precious .product-grid {
    display: grid !important;
    grid-template-columns: repeat(3, 1fr) !important;
    gap: 40px;
  }

  .card-image-wrapper {
    position: relative;
    overflow: hidden;
    border-radius: 4px;
    background: #f9f9f9;
  }

  .custom-product-card img {
    width: 100%;
    aspect-ratio: 1/1;
    object-fit: cover;
    display: block;
    transition: transform 0.5s ease;
  }

  .custom-product-card:hover img { transform: scale(1.05); }
  
  .card-info { padding: 20px 0; text-align: center; }
  .card-info h3 { font-size: 20px; font-weight: 400; line-height: 1.4; color: var(--color-earth-dark); }

  .sale-badge {
    position: absolute;
    top: 15px;
    left: 15px;
    background: #FFD700;
    color: black;
    font-weight: 700;
    padding: 4px 10px;
    font-size: 13px;
    z-index: 2;
    border-radius: 2px;
  }

  .quick-view-bar {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background: rgba(44, 44, 44, 0.85);
    color: white;
    text-align: center;
    padding: 14px;
    font-size: 14px;
    transform: translateY(100%);
    transition: transform 0.3s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    cursor: pointer;
    z-index: 5;
  }
  
  .card-image-wrapper:hover .quick-view-bar { transform: translateY(0); }

  .icon-eye svg { width: 16px; height: 16px; fill: white; }

  @media (max-width: 1024px) {
    .pure-potent-precious .product-grid { grid-template-columns: repeat(2, 1fr) !important; gap: 20px; }
  }

  @media (max-width: 640px) {
    .pure-potent-precious { padding: 60px 0 !important; }
    .pure-potent-precious .h1 { font-size: 42px !important; margin-bottom: 40px !important; }
    .pure-potent-precious .product-grid { 
      grid-template-columns: repeat(2, 1fr) !important; 
      gap: 12px !important; 
    }
    .card-info { padding: 15px 5px !important; }
    .card-info h3 { font-size: 15px !important; min-height: 4.2em; }
    .sale-badge { font-size: 10px !important; padding: 3px 6px !important; top: 10px; left: 10px; }
  }
</style>

{% schema %}
{
  "name": "Pure Potent Grid",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Pure. Potent. Precious."
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "1. Upload from Shopify (Recommended)"
        },
        {
          "type": "text",
          "id": "asset_image",
          "label": "2. Fallback Asset Name (Advanced)",
          "info": "Only use this if you want to use a file from the theme assets folder."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Product Title"
        },
        {
          "type": "text",
          "id": "sale_label",
          "label": "Sale Badge Text",
          "default": "SALE"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Pure Potent Grid",
      "blocks": [
        { "type": "product", "settings": { "title": "Product 1" } },
        { "type": "product", "settings": { "title": "Product 2" } },
        { "type": "product", "settings": { "title": "Product 3" } },
        { "type": "product", "settings": { "title": "Product 4" } }
      ]
    }
  ]
}
{% endschema %}
