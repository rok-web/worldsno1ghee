<section class="hero" style="background-image: url('{{ section.settings.image | image_url: width: 2000 }}');">
  <div class="container">
    <div class="hero-content" data-aos="fade-up">
      <span class="hero-tagline">{{ section.settings.tagline }}</span>
      <h1 class="hero-title h1">{{ section.settings.title }}</h1>
      
      <a href="{{ section.settings.button_link }}" class="btn btn-gold">
        {{ section.settings.button_label }}
      </a>

      <div class="hero-counters">
        <div class="counter-item">
          <span class="number" data-count="{{ section.settings.stat_1_val }}">0</span>
          <span class="label">{{ section.settings.stat_1_label }}</span>
        </div>
        <div class="counter-item">
          <span class="number" data-count="{{ section.settings.stat_2_val }}">0</span>
          <span class="label">{{ section.settings.stat_2_label }}</span>
        </div>
        <div class="counter-item">
          <span class="number" data-count="{{ section.settings.stat_3_val }}">0</span>
          <span class="label">{{ section.settings.stat_3_label }}</span>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background Image"
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline",
      "default": "MODERN MACHINERY DESTROYS NUTRIENTS"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Taste of Farming"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Buy A2 Ghee"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "header",
      "content": "Statistics"
    },
    {
      "type": "text",
      "id": "stat_1_label",
      "label": "Stat 1 Label",
      "default": "% Forest Fed"
    },
    {
      "type": "number",
      "id": "stat_1_val",
      "label": "Stat 1 Value",
      "default": 100
    },
    {
      "type": "text",
      "id": "stat_2_label",
      "label": "Stat 2 Label",
      "default": "Kapila Genetics"
    },
    {
      "type": "number",
      "id": "stat_2_val",
      "label": "Stat 2 Value",
      "default": 100
    },
    {
      "type": "text",
      "id": "stat_3_label",
      "label": "Stat 3 Label",
      "default": "Year Tradition"
    },
    {
      "type": "number",
      "id": "stat_3_val",
      "label": "Stat 3 Value",
      "default": 3000
    }
  ],
  "presets": [
    {
      "name": "Hero"
    }
  ]
}
{% endschema %}
