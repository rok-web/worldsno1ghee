<section class="cart-page-section" style="padding: 100px 0;">
  <div class="container">
    <h1 class="h2" style="margin-bottom: 60px;">Your Cart</h1>

    {% if cart.item_count > 0 %}
      <form action="/cart" method="post" novalidate>
        <div class="cart-items">
          <table style="width: 100%; border-collapse: collapse;">
            <thead>
              <tr style="border-bottom: 1px solid #ddd; text-align: left;">
                <th style="padding-bottom: 20px;">Product</th>
                <th style="padding-bottom: 20px;">Price</th>
                <th style="padding-bottom: 20px;">Quantity</th>
                <th style="padding-bottom: 20px; text-align: right;">Total</th>
              </tr>
            </thead>
            <tbody>
              {% for item in cart.items %}
                <tr style="border-bottom: 1px solid #eee;">
                  <td style="padding: 30px 0;">
                    <div style="display: flex; gap: 20px; align-items: center;">
                      <img src="{{ item.image | image_url: width: 120 }}" alt="{{ item.title }}" style="width: 100px; border-radius: 8px;">
                      <div>
                        <h4 class="h4" style="font-size: 18px;">{{ item.product.title }}</h4>
                        {% unless item.variant.title contains 'Default' %}
                          <p style="font-size: 14px; opacity: 0.6;">{{ item.variant.title }}</p>
                        {% endunless %}
                        <a href="{{ item.url_to_remove }}" style="font-size: 12px; color: var(--color-gold); margin-top: 10px; display: inline-block;">Remove</a>
                      </div>
                    </div>
                  </td>
                  <td>{{ item.price | money }}</td>
                  <td>
                    <div class="qty-input" style="width: 120px;">
                      <button type="submit" name="updates[]" value="{{ item.quantity | minus: 1 }}" class="qty-btn">-</button>
                      <input type="number" name="updates[]" value="{{ item.quantity }}" min="0" style="width: 40px; text-align: center; border: none;">
                      <button type="submit" name="updates[]" value="{{ item.quantity | plus: 1 }}" class="qty-btn">+</button>
                    </div>
                  </td>
                  <td style="text-align: right; font-weight: 600;">{{ item.final_line_price | money }}</td>
                </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>

        <div class="cart-footer" style="display: flex; justify-content: flex-end; margin-top: 60px;">
          <div style="max-width: 400px; width: 100%;">
            <div style="display: flex; justify-content: space-between; font-size: 24px; font-weight: 600; margin-bottom: 30px;">
              <span>Subtotal</span>
              <span>{{ cart.total_price | money }}</span>
            </div>
            <p style="font-size: 14px; opacity: 0.6; margin-bottom: 30px;">Shipping & taxes calculated at checkout</p>
            
            <div class="cart-note" style="margin-bottom: 30px;">
              <label style="display: block; margin-bottom: 10px;">Order Note</label>
              <textarea name="note" rows="4" style="width: 100%; padding: 15px; border: 1px solid #ddd; border-radius: 4px;">{{ cart.note }}</textarea>
            </div>

            <button type="submit" name="checkout" class="btn btn-gold" style="width: 100%; padding: 20px;">Check Out</button>
          </div>
        </div>
      </form>
    {% else %}
      <div style="text-align: center; padding: 100px 0;">
        <p class="p-large">Your cart is currently empty.</p>
        <a href="/collections/all" class="btn btn-gold" style="margin-top: 30px;">Continue Shopping</a>
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Cart Page",
  "settings": []
}
{% endschema %}
