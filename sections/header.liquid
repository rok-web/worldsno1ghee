<header class="site-header">
  <div class="container">
    <div class="header-inner">
      <!-- Hamburger for Mobile -->
      <button class="mobile-nav-toggle" aria-label="Menu">
        {% render 'icons', icon: 'hamburger' %}
      </button>

      <!-- Logo -->
      <div class="header-logo">
        <a href="/">
          {% if section.settings.logo != blank %}
            <img src="{{ section.settings.logo | image_url: height: 120 }}" alt="{{ shop.name }}" loading="lazy">
          {% else %}
            <span class="h4">{{ shop.name }}</span>
          {% endif %}
        </a>
      </div>

      <!-- Desktop Nav -->
      <nav class="main-nav">
        {% for link in section.settings.menu.links %}
          <a href="{{ link.url }}" class="nav-link {% if link.active %}active{% endif %}">
            {{ link.title }}
          </a>
        {% endfor %}
      </nav>

      <!-- Actions -->
      <div class="header-actions">
        <a href="/collections/all" class="btn btn-gold header-cta hide-mobile">
          {{ section.settings.cta_text }}
        </a>
        <a href="/cart" class="cart-icon-wrapper" id="cart-icon-bubble">
          {% render 'icons', icon: 'cart' %}
          <span class="cart-count">{{ cart.item_count }}</span>
        </a>
      </div>
    </div>
  </div>

  <!-- Mobile Menu Drawer -->
  <div class="mobile-menu-overlay"></div>
  <div class="mobile-menu-drawer">
    <div class="drawer-header">
      <div class="header-logo">
        <img src="{{ section.settings.logo | image_url: height: 80 }}" alt="{{ shop.name }}" loading="lazy">
      </div>
      <button class="mobile-menu-close">&times;</button>
    </div>
    <nav class="mobile-nav">
      {% for link in section.settings.menu.links %}
        <a href="{{ link.url }}" class="mobile-nav-link">
          {{ link.title }}
        </a>
      {% endfor %}
      <a href="/collections/all" class="btn btn-gold" style="margin-top: 30px; width: 100%; text-align: center;">
        {{ section.settings.cta_text }}
      </a>
    </nav>
  </div>
</header>

<style>
  .header-cta {
    padding: 10px 25px;
    font-size: 14px;
  }
  
  .mobile-menu-drawer {
    position: fixed;
    top: 0;
    left: -300px;
    width: 300px;
    height: 100%;
    background: var(--color-earth-dark);
    z-index: 1001;
    transition: left 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
    padding: 30px;
    display: flex;
    flex-direction: column;
  }

  .mobile-menu-drawer.open {
    left: 0;
  }

  .mobile-nav {
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin-top: 40px;
  }

  .mobile-nav-link {
    color: var(--color-white);
    font-size: 18px;
    font-weight: 500;
    border-bottom: 1px solid rgba(255,255,255,0.1);
    padding-bottom: 10px;
  }

  .mobile-nav-toggle {
    display: none;
    color: var(--color-white);
  }

  .site-header.is-sticky .mobile-nav-toggle {
    color: var(--color-earth-dark);
  }

  @media (max-width: 768px) {
    .mobile-nav-toggle { display: block; }
    .header-cta { display: none; }
    .main-nav { display: none; }
    .site-header { top: 40px; } /* keep below fixed announcement bar */
    .site-header.is-sticky { background: var(--color-white); }
  }
</style>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA Button Text",
      "default": "Buy A2 Ghee"
    }
  ]
}
{% endschema %}
