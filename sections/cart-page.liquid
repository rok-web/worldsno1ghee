<section class="section-padding">
  <div class="container">
    <div class="section-title">
      <h2>Your Cart</h2>
    </div>

    {% if cart.item_count > 0 %}
      <form action="/cart" method="post" novalidate>
        <table style="width: 100%; border-collapse: collapse; margin-bottom: 30px;">
          <thead>
            <tr style="border-bottom: 2px solid var(--color-gold);">
              <th style="text-align: left; padding: 15px 0;">Product</th>
              <th style="text-align: center; padding: 15px 0;">Quantity</th>
              <th style="text-align: right; padding: 15px 0;">Total</th>
            </tr>
          </thead>
          <tbody>
            {% for item in cart.items %}
              <tr style="border-bottom: 1px solid #eee;">
                <td style="padding: 20px 0;">
                  <div style="display: flex; align-items: center; gap: 20px;">
                    <img src="{{ item.image | image_url: width: 100 }}" alt="{{ item.title }}" style="border-radius: 4px;">
                    <div>
                      <h4 style="margin: 0;">{{ item.product.title }}</h4>
                      <p style="margin: 5px 0 0; color: #666;">{{ item.variant.title }}</p>
                      <a href="/cart/change?line={{ forloop.index }}&quantity=0" style="color: #E74C3C; font-size: 12px; font-weight: 700;">Remove</a>
                    </div>
                  </div>
                </td>
                <td style="text-align: center;">
                  <input type="number" name="updates[]" value="{{ item.quantity }}" min="0" style="width: 60px; padding: 5px; text-align: center; border: 1px solid #ddd;">
                </td>
                <td style="text-align: right; font-weight: 700;">
                  {{ item.final_line_price | money }}
                </td>
              </tr>
            {% endfor %}
          </tbody>
        </table>

        <div style="text-align: right;">
          <h3 style="margin-bottom: 10px;">Subtotal: {{ cart.total_price | money }}</h3>
          <p style="color: #666; margin-bottom: 20px;">Taxes and shipping calculated at checkout</p>
          <button type="submit" name="update" class="btn btn-outline" style="margin-right: 15px;">Update Cart</button>
          <button type="submit" name="checkout" class="btn">Check Out</button>
        </div>
      </form>
    {% else %}
      <div style="text-align: center; padding: 100px 0;">
        <p style="font-size: 20px; margin-bottom: 30px;">Your cart is currently empty.</p>
        <a href="/collections/all" class="btn">Continue Shopping</a>
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Cart Page",
  "settings": []
}
{% endschema %}
