<section class="collection-header" style="padding: 80px 0; background-color: var(--color-earth-dark); color: var(--color-white); text-align: center;">
  <div class="container">
    {% render 'breadcrumb' %}
    <h1 class="h2">{{ collection.title }}</h1>
    {% if collection.description != blank %}
      <div class="collection-description" style="margin-top: 20px; opacity: 0.8; max-width: 800px; margin-inline: auto;">
        {{ collection.description }}
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Collection Header",
  "settings": []
}
{% endschema %}
