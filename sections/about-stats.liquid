<section class="about-stats" style="padding: 100px 0; background-color: var(--color-white);">
  <div class="container">
    <div class="section-header" data-aos="fade-up">
      <h2 class="h2">The Bilona Promise</h2>
      <p class="p-large" style="max-width: 800px; margin: 20px auto;">We boil raw A2 milk over firewood, culture it into curd in earthen pots, and hand-churn it at dawn. We never use cream separators. This slow process retains 100% of the nutrients.</p>
    </div>

    <div class="stats-grid">
      <div class="stat-card" data-aos="fade-up">
        <div class="stat-number">30L</div>
        <div class="h4">Milk for 1L Ghee</div>
      </div>
      <div class="stat-card" data-aos="fade-up" data-aos-delay="200">
        <div class="stat-number">100%</div>
        <div class="h4">Forest Grazed</div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "About Stats",
  "settings": []
}
{% endschema %}
