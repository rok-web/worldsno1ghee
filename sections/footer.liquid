<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <!-- Col 1: Brand -->
      <div class="footer-col">
        <div class="footer-logo">
          <img src="{{ section.settings.logo | image_url: height: 100 }}" alt="{{ shop.name }}" loading="lazy">
        </div>
        <p class="footer-tagline">{{ section.settings.tagline }}</p>
        <p class="fssai-no" style="margin-top: 20px; font-size: 12px; color: var(--color-gold);">FSSAI No: 10124025000164</p>
      </div>

      <!-- Col 2: Contact -->
      <div class="footer-col">
        <h4 class="footer-heading">Connect</h4>
        <ul class="footer-links">
          <li>Email: Customer@worldsno1bestghee.in</li>
          <li>Phone: +91 8555-926620</li>
          <li>Address: #15-116-12-2-10, Kamma Gadda Street, Madanapalle, Annamayya, AP-517325</li>
        </ul>
      </div>

      <!-- Col 3: Quick Links -->
      <div class="footer-col">
        <h4 class="footer-heading">Quick Links</h4>
        <ul class="footer-links">
          {% for link in section.settings.menu.links %}
            <li><a href="{{ link.url }}">{{ link.title }}</a></li>
          {% endfor %}
        </ul>
      </div>

      <!-- Col 4: Policies -->
      <div class="footer-col">
        <h4 class="footer-heading">Policies</h4>
        <ul class="footer-links">
          {% for link in section.settings.policy_menu.links %}
            <li><a href="{{ link.url }}">{{ link.title }}</a></li>
          {% endfor %}
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <p>&copy; {{ 'now' | date: "%Y" }} {{ shop.name }}. All rights reserved.</p>
      <p>Made with ❤️ for Vedic Traditions.</p>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Footer Logo"
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline",
      "default": "Modern machinery destroys nutrients. We use the 3,000-year-old Bilona Method."
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Main Menu"
    },
    {
      "type": "link_list",
      "id": "policy_menu",
      "label": "Policy Menu"
    }
  ]
}
{% endschema %}
