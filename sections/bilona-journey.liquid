<section class="bilona-journey" style="padding: 100px 0; background-color: var(--color-cream-bg);">
  <div class="container">
    <div class="section-header" data-aos="fade-up">
      <h2 class="h2">{{ section.settings.title }}</h2>
      <p class="p-large">{{ section.settings.subtitle }}</p>
    </div>

    <div class="journey-steps">
      {% for block in section.blocks %}
        <div class="journey-step" data-aos="fade-up" data-aos-delay="{{ forloop.index | times: 100 }}">
          <div class="step-image">
            <span class="step-number">{{ forloop.index }}</span>
            {% if block.settings.image != blank %}
              <img src="{{ block.settings.image | image_url: width: 800 }}" alt="{{ block.settings.title }}" style="display: block; width: 100%; height: auto; min-height: 200px; background: #f0f0f0;">
            {% elsif block.settings.asset_image != blank %}
              <img src="{{ block.settings.asset_image | asset_url }}" alt="{{ block.settings.title }}" style="display: block; width: 100%; height: auto; min-height: 200px; background: #f0f0f0;">
            {% else %}
              <div style="width: 100%; height: 300px; background: #eee; display: flex; align-items: center; justify-content: center;">
                {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
              </div>
            {% endif %}
          </div>
          <div class="step-content">
            <h3 class="h3 step-title">{{ block.settings.title }}</h3>
            <div class="p-large">{{ block.settings.text }}</div>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Bilona Journey",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "The Ancient Vedic Journey"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subheading",
      "default": "A 3,000-year-old process, preserved for your health."
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "1. Upload from Shopify (Recommended)"
        },
        {
          "type": "text",
          "id": "asset_image",
          "label": "2. Fallback Asset Name (Advanced)",
          "info": "Only use this if you want to use a file from the theme assets folder."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Step Title"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Step Description"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Bilona Journey"
    }
  ]
}
{% endschema %}
