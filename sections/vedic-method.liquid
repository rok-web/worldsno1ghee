<section class="split-banner {% if section.settings.reverse %}reverse{% endif %}" style="background-color: {{ section.settings.bg_color }};">
  <div class="banner-image" data-aos="fade-up">
    <img src="{{ section.settings.image | image_url: width: 1000 }}" alt="{{ section.settings.title }}" loading="lazy">
  </div>
  <div class="banner-content" data-aos="fade-up">
    <h2 class="h2" style="color: {{ section.settings.text_color }};">{{ section.settings.title }}</h2>
    <div class="banner-text" style="color: {{ section.settings.text_color }}; margin: 30px 0; opacity: 0.8;">
      {{ section.settings.text }}
    </div>
    <a href="{{ section.settings.button_link }}" class="btn btn-gold">
      {{ section.settings.button_label }}
    </a>
  </div>
</section>

{% schema %}
{
  "name": "Split Banner (Vedic)",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "checkbox",
      "id": "reverse",
      "label": "Reverse Layout (Text Left)",
      "default": true
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "The Vedic Method"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>3,000 years of wisdom packed into every jar. Our Bilona method ensures that every drop of Ghee is biologically active and nutrient-dense.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Read Our Story"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#1A1208"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#FFFFFF"
    }
  ],
  "presets": [
    {
      "name": "Split Banner (Vedic)"
    }
  ]
}
{% endschema %}
