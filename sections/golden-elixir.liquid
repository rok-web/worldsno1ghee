<section class="split-banner" style="background-color: {{ section.settings.bg_color }};">
  <div class="banner-image" data-aos="fade-right">
    {% if section.settings.image != blank %}
      <img src="{{ section.settings.image | image_url: width: 1000 }}" alt="{{ section.settings.title }}" loading="lazy">
    {% else %}
      <img src="{{ 'golden-elixir-bg.png' | asset_url }}" alt="{{ section.settings.title }}" loading="lazy">
    {% endif %}
  </div>
  <div class="banner-content" data-aos="fade-left">
    <h2 class="h2" style="color: {{ section.settings.text_color }};">{{ section.settings.title }}</h2>
    <div class="banner-text" style="color: {{ section.settings.text_color }}; margin: 30px 0; opacity: 0.8;">
      {{ section.settings.text }}
    </div>
    <a href="{{ section.settings.button_link }}" class="btn btn-gold">
      {{ section.settings.button_label }}
    </a>
  </div>
</section>

{% schema %}
{
  "name": "Split Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "The Golden Elixir"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Discover the pure, golden essence of the Vedic method. Our A2 Ghee is more than just food; it's a legacy of health.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Buy A2 Ghee"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#1A1208"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#FFFFFF"
    }
  ],
  "presets": [
    {
      "name": "Split Banner"
    }
  ]
}
{% endschema %}
