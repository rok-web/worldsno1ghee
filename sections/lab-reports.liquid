<section class="lab-reports-section" style="padding: 100px 0;">
  <div class="container">
    <div class="section-header" data-aos="fade-up">
      <h1 class="h2">Our Lab Reports</h1>
      <p class="p-large" style="margin-top: 20px;">Transparency is our priority. View our latest laboratory test results below.</p>
    </div>

    <div class="pdf-container" data-aos="fade-up" style="height: 1000px; margin-top: 60px;">
      <iframe src="https://docs.google.com/gview?embedded=true&url={{ section.settings.pdf_url | url_encode }}" style="width:100%; height:100%;" frameborder="0"></iframe>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Lab Reports",
  "settings": [
    {
      "type": "text",
      "id": "pdf_url",
      "label": "PDF URL",
      "default": "https://worldsno1bestghee.com/wp-content/uploads/2026/02/9da61a6b-9795-41e1-9073-aa0347d4f63d.pdf"
    }
  ]
}
{% endschema %}
