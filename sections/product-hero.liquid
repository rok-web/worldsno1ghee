<section class="product-hero">
  <div class="container">
    <div class="product-main">
      <!-- Image Gallery -->
      <div class="product-gallery" data-aos="fade-right">
        <img src="{{ product.featured_image | image_url: width: 1000 }}" alt="{{ product.title }}" id="MainProductImage">
        <div class="product-thumbnails" style="display: flex; gap: 10px; margin-top: 20px;">
          {% for image in product.images %}
            <img src="{{ image | image_url: width: 200 }}" alt="{{ image.alt }}" style="width: 80px; cursor: pointer; border-radius: 4px;" onclick="document.getElementById('MainProductImage').src='{{ image | image_url: width: 1000 }}'">
          {% endfor %}
        </div>
      </div>

      <!-- Details -->
      <div class="product-details" data-aos="fade-left">
        <nav class="breadcrumb" style="margin-bottom: 20px; font-size: 14px; opacity: 0.6;">
          <a href="/">Home</a> / <a href="/collections/all">Shop</a> / {{ product.title }}
        </nav>
        
        <h1 class="h2">{{ product.title }}</h1>
        <div class="price">
          {% render 'price', product: product %}
        </div>

        <div class="product-description" style="margin: 30px 0;">
          {{ product.description }}
        </div>

        <form method="post" action="/cart/add" id="product-form">
          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
          
          {% unless product.has_only_default_variant %}
            <div class="variant-selector" style="margin-bottom: 30px;">
              <label style="display: block; margin-bottom: 10px; font-weight: 600;">Select Size</label>
              <select name="id" style="width: 100%; padding: 15px; border-radius: 4px; border: 1px solid #ddd;">
                {% for variant in product.variants %}
                  <option value="{{ variant.id }}">{{ variant.title }} - {{ variant.price | money }}</option>
                {% endfor %}
              </select>
            </div>
          {% endunless %}

          <div class="quantity-selector">
            <label style="font-weight: 600;">Quantity</label>
            <div class="qty-input">
              <button type="button" class="qty-btn" onclick="let q=document.getElementById('Quantity'); if(q.value>1) q.value--;">-</button>
              <input type="number" id="Quantity" name="quantity" value="1" min="1" style="width: 60px; text-align: center; border: none;">
              <button type="button" class="qty-btn" onclick="let q=document.getElementById('Quantity'); q.value++;">+</button>
            </div>
          </div>

          <button type="submit" class="btn btn-gold" style="width: 100%; margin-top: 30px; padding: 20px;">
            Add to Cart
          </button>
        </form>

        {% section 'product-trust-badges' %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product Hero",
  "settings": []
}
{% endschema %}
